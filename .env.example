VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
PIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
# "mock" runs FBR calls against a built-in fake instead of PRAL (local development and tests only; leave unset in production).
FBR_ADAPTER=mock
# Protects the scheduled-job endpoints (FBR retries and reference sync).
CRON_SECRET=replace-with-a-long-random-string
